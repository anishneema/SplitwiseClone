{
  "name": "roomsplit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "node supabase/_localtest/seed-ui.mjs",
    "db:fresh": "npm run db:reset && npm run --silent db:seed > /tmp/seed.json && npm run --silent db:sessions && echo 'seed -> /tmp/seed.json, cookies -> /tmp/cookies-*.json'",
    "db:sessions": "node supabase/_localtest/mint-session.mjs anish.e2e@example.com > /tmp/cookies-anish.json && node supabase/_localtest/mint-session.mjs nav.e2e@example.com > /tmp/cookies-nav.json && node supabase/_localtest/mint-session.mjs sam.e2e@example.com > /tmp/cookies-sam.json",
    "db:types": "supabase gen types typescript --local > src/lib/types/database.ts",
    "test:db": "node supabase/_localtest/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:sql": "./supabase/_localtest/run-sql-checks.sh",
    "test:ui": "node supabase/_localtest/ui/flows.mjs && node supabase/_localtest/ui/splits.mjs",
    "test:local": "npm run check && npm run test:sql && npm run test:db",
    "ui:open": "node supabase/_localtest/ui/open.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "supabase": "^2.75.0"
  }
}
